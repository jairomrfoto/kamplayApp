# ── Kamplay — variables de entorno locales ────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local al repositorio

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Bypass de suscripción (solo desarrollo local) ─────────────────────────────
# Permite crear campamentos sin suscripción activa de Stripe
# Elimina esta línea o pon false antes de desplegar a producción
VITE_BYPASS_SUBSCRIPTION=true

# ── Admin ─────────────────────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=

# ── Stripe (producción) ───────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=
