rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isCoordinator(campId) {
      return isAuth() &&
        get(/databases/$(database)/documents/campamentos/$(campId)).data.mainCoordinator == request.auth.uid;
    }

    // Admin: UID must exist in the admins collection (created manually in Firebase Console)
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Stripe-managed fields that only Cloud Functions (Admin SDK) may write
    function touchesStripeFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionStatus',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeConnectId',
        'connectOnboarded',
      ]);
    }

    // Coordinator has an active Kamplay subscription
    function hasActiveSubscription(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.subscriptionStatus == 'active';
    }

    // ── Admin collection — only admin can read their own doc; no client writes ─
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Join codes — any authenticated user can look up a code to join ────────
    match /codigos/{code} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── User profiles — each user manages only their own; admin reads all ─────
    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !touchesStripeFields();
      allow update: if isOwner(userId) && !touchesStripeFields();
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Camps ─────────────────────────────────────────────────────────────────
    match /campamentos/{campId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasActiveSubscription(request.auth.uid);
      allow update, delete: if isAuth() &&
        (resource.data.mainCoordinator == request.auth.uid || isAdmin());

      match /profesorDocs/{docId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && request.resource.data.autorId == request.auth.uid;
        allow delete: if isAuth() && resource.data.autorId == request.auth.uid;
      }

      match /{subcollection}/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    // ── Pagos — admin reads all; payer or coordinator reads own ──────────────
    match /pagos/{pagoId} {
      allow read: if isAdmin() || (isAuth() && (
        resource.data.parentUid == request.auth.uid ||
        isCoordinator(resource.data.campId)
      ));
      allow write: if false;
    }
  }
}
